{
  "name": "koishi-plugin-group-assistant",
  "description": "面向 Koishi 的群聊准入、内容治理与 AI 审核插件",
  "version": "1.0.1",
  "main": "lib/index.js",
  "typings": "lib/index.d.ts",
  "scripts": {
    "build": "node -e \"const fs=require('fs');fs.rmSync('lib',{recursive:true,force:true});fs.rmSync('tsconfig.tsbuildinfo',{force:true})\" && tsc --pretty false && esbuild src/index.ts --bundle --platform=node --format=cjs --external:koishi --outfile=lib/index.js",
    "typecheck": "tsc --pretty false",
    "test": "esbuild tests/similarity.test.ts --bundle --platform=node --format=cjs --outfile=.test/similarity.test.cjs && node --test .test/similarity.test.cjs && node -e \"require('fs').rmSync('.test',{recursive:true,force:true})\""
  },
  "files": [
    "lib",
    "dist"
  ],
  "license": "MIT",
  "keywords": [
    "chatbot",
    "koishi",
    "plugin",
    "group-management",
    "moderation",
    "deepseek"
  ],
  "devDependencies": {
    "esbuild": "^0.23.1",
    "typescript": "^5.5.4"
  },
  "peerDependencies": {
    "koishi": "^4.17.11"
  }
}
